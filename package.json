{
  "name": "longhome",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted home for permanent, family-stewarded memorial pages.",
  "license": "MIT",
  "homepage": "https://github.com/adrian-mei/LongHome#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian-mei/LongHome.git"
  },
  "bugs": {
    "url": "https://github.com/adrian-mei/LongHome/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && cpx \"src/views/**/*\" dist/views && cpx \"src/public/**/*\" dist/public",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/view": "^12.0.0",
    "better-sqlite3": "^13.0.3",
    "ejs": "^7.0.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.20.5",
    "cpx2": "^9.0.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
