# Optional. When set, visitors must enter this token before creating a memorial.
LONGHOME_WRITE_TOKEN=

LONGHOME_HOST=0.0.0.0
LONGHOME_PORT=3000
LONGHOME_HTTP_PORT=3000
LONGHOME_DATA_DIR=./data
# Set this to the public origin when sharing invite and steward links.
# Example: https://remember.example.com
LONGHOME_PUBLIC_URL=
LONGHOME_MAX_PHOTO_MB=15
LONGHOME_MAX_VIDEO_MB=250

# Optional AI story co-writer. Leave the provider empty to disable it.
# Hosted: openai, anthropic, gemini (API key and model required)
# Signed-in local CLI: claude-cli, codex-cli (model optional; native Node runs only)
LONGHOME_AI_PROVIDER=
LONGHOME_AI_API_KEY=
LONGHOME_AI_MODEL=
LONGHOME_AI_TIMEOUT_MS=60000
