<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Create a family-stewarded memorial in LongHome." />
    <title>Create a memorial · LongHome</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <% if (aiEnabled) { %><script src="/assets/assist.js" defer></script><% } %>
  </head>
  <body>
    <header class="site-header shell">
      <a class="wordmark" href="/">LongHome</a>
      <a class="text-link" href="/">Return home</a>
    </header>

    <main class="form-shell shell">
      <div class="form-intro">
        <p class="eyebrow">Create a memorial</p>
        <h1>Begin with their name and a photograph.</h1>
        <p>Everything else can be added only if it feels right.</p>
      </div>

      <% if (error) { %>
        <div class="error" role="alert"><%= error %></div>
      <% } %>

      <form id="memorial-form" action="/memorials" method="post" enctype="multipart/form-data" class="memorial-form">
        <% if (requiresWriteToken) { %>
          <label>
            <span>Publishing token</span>
            <input type="password" name="writeToken" required autocomplete="current-password" />
            <small>Provided by the person who runs this LongHome.</small>
          </label>
        <% } %>

        <label>
          <span>Name <strong>required</strong></span>
          <input name="name" value="<%= values.name %>" maxlength="120" required autocomplete="name" />
        </label>

        <div class="date-row">
          <label>
            <span>Birth date <em>optional</em></span>
            <input type="date" name="birthDate" value="<%= values.birthDate %>" />
          </label>
          <label>
            <span>End date <em>optional</em></span>
            <input type="date" name="deathDate" value="<%= values.deathDate %>" />
          </label>
        </div>

        <label>
          <span>Their story <em>optional</em></span>
          <textarea id="story" name="story" rows="8" maxlength="20000" placeholder="Write as much or as little as you want."><%= values.story %></textarea>
        </label>
        <input id="story-ai-assisted" type="hidden" name="storyAiAssisted" value="<%= values.storyAiAssisted %>" />

        <% if (aiEnabled) { %>
          <section class="ai-assist" aria-labelledby="ai-assist-title" data-provider="<%= aiProvider %>">
            <p class="eyebrow">Optional writing help</p>
            <h2 id="ai-assist-title">Shape your notes with <%= aiProvider %></h2>
            <p>
              Start with memories and facts in the story box. The assistant can shape them
              into a draft, but you decide every word that is published.
            </p>
            <div class="ai-controls">
              <label>
                <span>Tone</span>
                <select id="ai-tone">
                  <option value="warm">Warm and reflective</option>
                  <option value="factual">Simple and factual</option>
                  <option value="celebratory">Celebratory</option>
                </select>
              </label>
              <label>
                <span>Length</span>
                <select id="ai-length">
                  <option value="short">Short</option>
                  <option value="medium" selected>Medium</option>
                  <option value="long">Long</option>
                </select>
              </label>
            </div>
            <button id="ai-assist-button" class="button-secondary" type="button">
              Help me shape this story
            </button>
            <p id="ai-status" class="ai-status" role="status" aria-live="polite"></p>

            <section id="ai-preview" class="ai-preview" hidden aria-labelledby="ai-preview-title">
              <h3 id="ai-preview-title">Review the suggested draft</h3>
              <div id="ai-preview-text" class="ai-preview-text"></div>
              <div class="ai-preview-actions">
                <button id="ai-use-draft" class="button button-small" type="button">Use this draft</button>
                <button id="ai-keep-mine" class="button-secondary" type="button">Keep my version</button>
              </div>
              <small>Check every name, date, and detail before publishing.</small>
            </section>

            <dialog id="ai-consent" class="ai-consent">
              <form method="dialog">
                <p class="eyebrow">Before anything is sent</p>
                <h2>Share these notes with <%= aiProvider %>?</h2>
                <p>
                  LongHome will send the name, dates, and current story text to the configured
                  AI provider. Photos and videos are never sent. LongHome does not store this
                  request, but the provider may handle it under its own data policy.
                </p>
                <div class="ai-preview-actions">
                  <button class="button-secondary" value="cancel">Keep it private</button>
                  <button class="button button-small" value="confirm">Send and create draft</button>
                </div>
              </form>
            </dialog>
            <noscript><p class="ai-status">AI writing help requires JavaScript. The regular memorial form still works.</p></noscript>
          </section>
        <% } %>

        <fieldset class="visibility-fieldset">
          <legend>Who can visit?</legend>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="public" <%= values.visibility === "public" ? "checked" : "" %> />
            <span><strong>Public</strong> Listed on this LongHome and open to everyone.</span>
          </label>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="unlisted" <%= values.visibility === "unlisted" ? "checked" : "" %> />
            <span><strong>Unlisted</strong> Open to anyone with the memorial link, but not listed or indexed.</span>
          </label>
          <label class="visibility-option">
            <input type="radio" name="visibility" value="private" <%= values.visibility === "private" ? "checked" : "" %> />
            <span><strong>Private</strong> Only visitors holding an active invitation can see the page or media.</span>
          </label>
        </fieldset>

        <label>
          <span>Private invitation labels <em>one per line</em></span>
          <textarea name="invitees" rows="4" maxlength="1500" placeholder="Immediate family&#10;Close friends"><%= values.invitees %></textarea>
          <small>Used only for private memorials. LongHome creates a separate revocable link for each label; it does not send email.</small>
        </label>

        <label class="upload-field">
          <span>Photographs <strong>at least one required</strong></span>
          <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/gif" multiple required />
          <small>Up to 12 images, <%= maxPhotoMb %> each. JPEG, PNG, WebP, or GIF.</small>
        </label>

        <label class="upload-field">
          <span>Videos <em>optional</em></span>
          <input type="file" name="videos" accept="video/mp4,video/webm,video/quicktime" multiple />
          <small>Up to 4 videos, <%= maxVideoMb %> each. MP4, WebM, or QuickTime.</small>
        </label>

        <div class="form-actions">
          <button class="button" type="submit">Create their LongHome</button>
          <p>You will receive a private steward link after creation.</p>
        </div>
      </form>
    </main>
  </body>
</html>
